PORT=4000
NODE_ENV=production
TZ=Asia/Jakarta

# Database Configuration (MySQL - cPanel)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=https://gate.ukmiptek.org

# QRIS & Payment Gateway Otomatis (0% MDR / Tanpa Potongan)
QRIS_MERCHANT_NAME=Bendahara UKM IPTEK
QRIS_NMID=BELUM_DIKONFIGURASI
# Opsional: raw string QRIS statis (atau simpan via UI Bendahara ke public/uploads/qris/qris_payload.txt)
QRIS_STATIC_PAYLOAD=
# Rahasia webhook untuk aplikasi Android Notification Forwarder / MacroDroid
PAYMENT_WEBHOOK_SECRET=ganti_dengan_secret_acak_panjang
INVOICE_EXPIRE_MINUTES=15

# AI Verification Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
