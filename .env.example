PORT=4000
NODE_ENV=production
TZ=Asia/Jakarta

# Database Configuration (MySQL - cPanel)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h
CLIENT_ORIGIN=https://gate.ukmiptek.org

# QRIS Configuration (Bendahara)
QRIS_MERCHANT_NAME=Bendahara UKM IPTEK
QRIS_NMID=BELUM_DIKONFIGURASI

# AI Verification Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
