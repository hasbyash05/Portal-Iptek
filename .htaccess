Options -Indexes +ExecCGI
AddHandler cgi-script .cgi

# Lindungi file backend, konfigurasi, dan log agar tidak dapat diakses via HTTP
<FilesMatch "^(\.env|\.env\.example|\.cpanel\.yml|\.cpignore|\.gitignore|Cargo\.toml|Cargo\.lock|login_credentials\.json|stderr\.log|server\.log|iptek-backend|\.db_schema_v2)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Teruskan header Authorization & X-Webhook-Secret ke CGI Rust
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_WEBHOOK_SECRET:%{HTTP:X-Webhook-Secret}]

  # Blokir akses langsung ke direktori internal Rust & Git
  RewriteRule ^(\.git|src|target)(/.*)?$ - [F,L]

  # Paksa HTTPS (komentari 2 baris berikut jika SSL domain belum aktif)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 1. Semua endpoint API dijalankan langsung oleh LiteSpeed via binary Rust CGI (tidak pernah down)
  RewriteRule ^api/(.*)$ api.cgi/api/$1 [L,QSA]

  # 2. Direktori asset/ dilayani langsung oleh LiteSpeed
  RewriteCond %{REQUEST_URI} ^/asset/
  RewriteRule ^ - [L]

  # 3. Halaman utama dilayani langsung oleh LiteSpeed dari public/index.html
  RewriteRule ^$ public/index.html [L]

  # 4. File statis di public/ (css, js, img, uploads, manifest, sw.js) dilayani langsung oleh LiteSpeed
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # 5. Fallback ke halaman utama
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ public/index.html [L]
</IfModule>
