Options -Indexes

# Lindungi file backend, binary Rust, konfigurasi, dan log agar tidak dapat diakses via HTTP
<FilesMatch "^(\.env|\.env\.example|\.cpanel\.yml|\.cpignore|\.gitignore|Cargo\.toml|Cargo\.lock|login_credentials\.json|stderr\.log|server\.log|iptek-backend)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Blokir akses langsung ke direktori internal Rust & Git
  RewriteRule ^(\.git|src|target)(/.*)?$ - [F,L]

  # Paksa HTTPS (komentari 2 baris berikut jika SSL domain belum aktif)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 1. Semua endpoint API diteruskan ke backend Rust di localhost port 4000
  RewriteRule ^api/(.*)$ http://127.0.0.1:4000/api/$1 [P,L]

  # 2. Direktori asset/ dilayani langsung oleh LiteSpeed
  RewriteCond %{REQUEST_URI} ^/asset/
  RewriteRule ^ - [L]

  # 3. Halaman utama dilayani langsung oleh LiteSpeed dari public/index.html
  RewriteRule ^$ public/index.html [L]

  # 4. File statis di public/ (css, js, img, uploads, manifest, sw.js) dilayani langsung oleh LiteSpeed
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  # 5. Fallback ke backend Rust jika bukan file statis
  RewriteRule ^(.*)$ http://127.0.0.1:4000/$1 [P,L]
</IfModule>
